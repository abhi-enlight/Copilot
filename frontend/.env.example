# =============================================================================
# Prism Copilot V2 — Production Environment Variables
# =============================================================================

# ── 1. Supabase (Database, Auth, Realtime Telemetry) ─────────────────────────
# REQUIRED: Must have NEXT_PUBLIC_ prefix so client browser can connect to Auth & Realtime
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# REQUIRED: Server-side service role key for bypassing RLS on audit logs & background jobs
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# OPTIONAL: Direct PostgreSQL connection string for database migrations & verification scripts
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-pooler.supabase.com:6543/postgres?sslmode=require

# ── 2. AI Model Engine (Gemini / OpenAI) ─────────────────────────────────────
# REQUIRED: Google Gemini API Key for direct sub-second agent streaming
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: Model identifier (defaults to gemini-2.5-flash)
LLM_MODEL=gemini-2.5-flash

# OPTIONAL: If using OpenAI models instead of Gemini
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── 3. Universal Connect Hub (Composio) ──────────────────────────────────────
# REQUIRED: Powers all 5 core tools (Outlook, Teams, Slack, Linear, Zoho CRM)
COMPOSIO_API_KEY=your_composio_api_key_here

# OPTIONAL: Webhook signature verification for /api/webhooks/composio
COMPOSIO_WEBHOOK_SECRET=your_composio_webhook_secret_here

# ── 4. Security & Human-in-the-Loop HMAC Signing ─────────────────────────────
# REQUIRED: 32+ character secret key for signing tamper-proof action proposals
PRISM_VAULT_KEY=your_random_32_char_secret_key_here

# ── 5. Production Host URL ───────────────────────────────────────────────────
# RECOMMENDED: Canonical production URL for OAuth redirects and webhook verification
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
