# ═══════════════════════════════════════════════════════════════════════
# PRISM V2 — ENVIRONMENT CONFIGURATION TEMPLATE
# Required by the V2 runtime.
# ═══════════════════════════════════════════════════════════════════════

# ── Supabase (Authentication & Persistence) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service-role key is required server-side for direct database operations,
# activity_events ingestion, agent_audit_logs ledger, and webhook handling.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# ── Composio Platform (Universal Tool Hub) ──────────────────────────────
# Consumed internally by @composio/core; the provider name must NEVER surface in the client UI.
COMPOSIO_API_KEY=ak_...

# ── LLM Frontier Model Providers (configure at least one) ───────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
