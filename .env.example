# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key is required server-side for the app_users / user_integrations /
# agent_audit_logs tables (RLS allows service_role only).
SUPABASE_SERVICE_ROLE_KEY=

# ── Microsoft 365 / Dynamics 365 ─────────────────────────────────────────────
AZURE_CLIENT_ID=
NEXT_PUBLIC_AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
AZURE_REDIRECT_URI=
# Dataverse org URL, e.g. https://your-org.crm.dynamics.com (enables the connection)
# WhoAmI security-role probe for CRM entitlement.
DYNAMICS_CRM_ORG_URL=

# ── Zoho (multi-tenant: each user connects their own account) ────────────────
# Create a "Self client" in https://api-console.zoho.in (or your data center)
# and add <origin>/api/integrations/zoho/callback as an allowed redirect URI.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# in | com | eu | com.au | jp (default: in)
ZOHO_DATACENTER=in
# Optional explicit override; defaults to <origin>/api/integrations/zoho/callback
ZOHO_REDIRECT_URI=

# ── Token vault encryption ───────────────────────────────────────────────────
# 32+ char secret. Access/refresh tokens in user_integrations are AES-256-GCM
# encrypted with a key derived from this value.
INTEGRATION_ENCRYPTION_KEY=

# ── Background token refresh (keeps vault tokens valid w/o re-connecting) ────
# Runs via src/instrumentation.ts inside the Next.js server. Set to "false"
# only for single-shot deployments that rely on the POST refresh endpoint.
TOKEN_REFRESH_ENABLED=true
# Cycle interval (default 900000 = 15 min; minimum 60000). Tokens expiring
# within a 10-minute freshness margin are refreshed proactively.
TOKEN_REFRESH_INTERVAL_MS=900000
# Shared secret for POST /api/integrations/refresh-tokens (cron trigger).
# Header: x-refresh-secret. Owners/admins can also trigger it from a session.
TOKEN_REFRESH_SECRET=

# ── n8n ──────────────────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=
NEXT_PUBLIC_N8N_WEBHOOK_URL=
N8N_ZOHO_SYNC_WEBHOOK=
N8N_ZOHO_DELETE_WEBHOOK=
N8N_ZOHO_UPDATE_WEBHOOK=
N8N_ZOHO_TASK_UPDATE_WEBHOOK=
N8N_RISK_WORKFLOW_WEBHOOK=
